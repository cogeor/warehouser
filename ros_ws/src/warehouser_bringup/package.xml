<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouser_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for warehouser system</description>
  <maintainer email="dev@example.com">Developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>warehouser_simulation</exec_depend>
  <exec_depend>warehouser_observations</exec_depend>
  <exec_depend>warehouser_rl_bridge</exec_depend>
  <exec_depend>warehouser_inference</exec_depend>
  <exec_depend>warehouser_safety</exec_depend>
  <exec_depend>warehouser_task</exec_depend>
  <exec_depend>warehouser_command</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
