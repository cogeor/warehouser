# Normalize line endings to LF on commit
* text=auto eol=lf

# Python files
*.py text eol=lf

# TypeScript/JavaScript files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# C++ files
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf

# Explicitly binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.onnx binary
*.zip binary
*.tar.gz binary
