# Warehouser Web Frontend Environment Configuration
# Copy this file to .env.local and modify as needed.
# Vite will automatically load environment variables from .env.local

# =============================================================================
# ROS Connection Settings
# =============================================================================

# WebSocket URL for rosbridge connection
# Default: ws://localhost:9090
# For production, use your rosbridge server address
VITE_ROS_WS_URL=ws://localhost:9090

# =============================================================================
# Notes
# =============================================================================
#
# All Vite environment variables must be prefixed with VITE_ to be exposed
# to the client-side code.
#
# For more configuration options, see src/config/index.ts
# Canvas settings, demo settings, and reconnection parameters are configured
# in code and do not require environment variables.
#
# Example production configuration:
#   VITE_ROS_WS_URL=wss://robot.example.com:9090
