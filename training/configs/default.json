{
  "env": {
    "obs_dim": 8,
    "action_dim": 4,
    "max_steps": 500,
    "world_width": 10.0,
    "world_height": 10.0,
    "robot_spawn": [1.0, 1.0, 0.0],
    "reward": {
      "progress_weight": 1.0,
      "collision_penalty": -100.0,
      "success_bonus": 100.0,
      "pickup_bonus": 50.0,
      "time_penalty": -0.1,
      "goal_threshold": 0.5
    }
  },
  "training": {
    "learning_rate": 0.0003,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "total_timesteps": 1000000,
    "eval_freq": 10000,
    "n_eval_episodes": 10,
    "save_freq": 50000,
    "policy_hidden": [64, 64],
    "value_hidden": [64, 64],
    "checkpoint_dir": "checkpoints",
    "log_dir": "logs"
  }
}
