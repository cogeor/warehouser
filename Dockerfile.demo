# Dockerfile for running the Warehouser demo with frontend support
FROM ros:jazzy-ros-base

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    g++-13 \
    python3-colcon-common-extensions \
    python3-pip \
    ros-jazzy-std-msgs \
    ros-jazzy-std-srvs \
    ros-jazzy-geometry-msgs \
    ros-jazzy-nav-msgs \
    ros-jazzy-sensor-msgs \
    ros-jazzy-rosbridge-suite \
    && rm -rf /var/lib/apt/lists/*

# Set GCC 13 as default
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100

# Create workspace
WORKDIR /ros_ws

# Copy source files
COPY ros_ws/src /ros_ws/src

# Source ROS2 and build
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --symlink-install

# Expose rosbridge port
EXPOSE 9090

# Default: launch demo
CMD ["/bin/bash", "-c", ". /opt/ros/jazzy/setup.sh && . /ros_ws/install/setup.sh && ros2 launch warehouser_bringup demo.launch.py"]
